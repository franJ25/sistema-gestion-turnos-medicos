# ==============================================================
# .gitignore - Sistema de Turnos Médicos
# ==============================================================

# --- Python ---
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Variables de entorno (NUNCA commitear) ---
.env
.env.local
*.env
!.env.example

# --- Base de datos ---
*.sqlite3
*.db

# --- Node.js / Frontend ---
node_modules/
.next/
out/
build/
.vercel

# --- Logs ---
*.log
npm-debug.log*

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Distribución ---
dist/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- PyInstaller ---
*.spec
